rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validEvent(event) {
      return event == null || (event is map && event.keys().hasAll(['title','date','time','location']) && event.keys().hasOnly(['title','date','time','location'])
        && event.title is string && event.title.size() > 0 && event.title.size() <= 100
        && event.location is string && event.location.size() > 0 && event.location.size() <= 120
        && event.date is string && event.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && event.time is string && (event.time == '' || event.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }
    function validPost(data) {
      return data.keys().hasAll(['authorId','authorName','college','body','event','createdAt','updatedAt'])
        && data.keys().hasOnly(['authorId','authorName','college','body','event','createdAt','updatedAt'])
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 120
        && data.college is string && data.college.size() > 0 && data.college.size() <= 100
        && data.body is string && data.body.size() <= 2000 && (data.body.size() > 0 || data.event != null)
        && validEvent(data.event) && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function bounded(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }
    function suggestionReviewer() {
      return member() && exists(/databases/$(database)/documents/campusSuggestionReviewers/$(request.auth.uid))
        && get(/databases/$(database)/documents/campusSuggestionReviewers/$(request.auth.uid)).data.enabled == true;
    }
    function suggestionOwner(id) {
      return member() && get(/databases/$(database)/documents/campusSuggestionOwners/$(id)).data.uid == request.auth.uid;
    }
    function validSuggestion(data) {
      return data.keys().hasAll(['name','host','authorName','anonymous','category','date','location','description','createdAt','status','reviewNote','reviewerId','reviewedAt'])
        && data.keys().hasOnly(['name','host','authorName','anonymous','category','date','location','description','createdAt','status','reviewNote','reviewerId','reviewedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.host is string && data.host.size() <= 100
        && data.authorName is string && data.authorName.size() <= 120 && data.anonymous is bool
        && (data.anonymous ? (data.authorName == '' && data.host == '') : (data.authorName.size() > 0 && data.host.size() > 0))
        && data.category in ['All','Tech','Arts','Music','Sports','Social','Academics']
        && data.date is string && (data.date == '' || data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
        && data.location is string && data.location.size() <= 120
        && data.description is string && data.description.size() > 0 && data.description.size() <= 500;
    }
    match /campusSuggestionReviewers/{uid} {
      allow get: if member() && request.auth.uid == uid;
    }
    match /campusSuggestionOwners/{id} {
      allow get: if member() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if member() && bounded(50) && resource.data.uid == request.auth.uid;
      allow create: if member() && request.resource.data.keys().hasAll(['uid','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','createdAt']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/campusSuggestions/$(id)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/campusSuggestions/$(id)).data.status == 'pending';
    }
    match /campusSuggestions/{id} {
      allow get: if suggestionReviewer() || suggestionOwner(id);
      allow list: if suggestionReviewer() && bounded(100);
      allow create: if member() && validSuggestion(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
        && request.resource.data.reviewNote == '' && request.resource.data.reviewerId == '' && request.resource.data.reviewedAt == null
        && getAfter(/databases/$(database)/documents/campusSuggestionOwners/$(id)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/campusSuggestionOwners/$(id)).data.createdAt == request.time;
      allow update: if suggestionReviewer() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','declined']
        && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 500
        && request.resource.data.reviewerId == request.auth.uid && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewerId','reviewedAt']);
    }
    match /campusFeedConnections/{connectionId} {
      function canChat() {
        let connection = get(/databases/$(database)/documents/campusFeedConnections/$(connectionId)).data;
        return member() && connection.status == 'accepted' && request.auth.uid in connection.members;
      }
      match /messages/{messageId} {
        allow get: if canChat();
        allow list: if canChat() && bounded(50);
        allow create: if canChat()
          && request.resource.data.keys().hasAll(['senderId','body','createdAt'])
          && request.resource.data.keys().hasOnly(['senderId','body','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if canChat() && resource.data.senderId == request.auth.uid;
      }
      match /reads/{uid} {
        allow get: if canChat();
        allow create, update: if canChat() && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['readAt']) && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
      allow get: if member() && request.auth.uid in resource.data.members;
      allow list: if member() && bounded(100) && request.auth.uid in resource.data.members;
      allow create: if member()
        && request.resource.data.keys().hasAll(['senderId','recipientId','members','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['senderId','recipientId','members','status','createdAt','updatedAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string && request.resource.data.recipientId != request.auth.uid
        && connectionId == request.auth.uid + '_' + request.resource.data.recipientId
        && request.resource.data.members == [request.auth.uid, request.resource.data.recipientId]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/campusFeedProfiles/$(request.resource.data.recipientId))
        && !exists(/databases/$(database)/documents/campusFeedConnections/$(request.resource.data.recipientId + '_' + request.auth.uid));
      allow update: if member() && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if member() && request.auth.uid in resource.data.members;
    }
    match /campusFeedProfiles/{uid} {
      match /savedPosts/{postId} {
        allow get: if member() && request.auth.uid == uid;
        allow list: if member() && request.auth.uid == uid && bounded(50);
        allow create: if member() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/campusFeedPosts/$(postId));
        allow delete: if member() && request.auth.uid == uid;
      }
      allow get: if member();
      allow list: if member() && bounded(100);
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['name','college','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','college','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.college is string && request.resource.data.college.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if member() && request.auth.uid == uid;
    }
    match /campusFeedPosts/{postId} {
      match /comments/{commentId} {
        allow get: if member() && exists(/databases/$(database)/documents/campusFeedPosts/$(postId));
        allow list: if member() && bounded(100) && exists(/databases/$(database)/documents/campusFeedPosts/$(postId));
        allow create: if member() && exists(/databases/$(database)/documents/campusFeedPosts/$(postId))
          && request.resource.data.keys().hasOnly(['uid','name','body','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if member() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/campusFeedPosts/$(postId)).data.authorId == request.auth.uid);
      }
      match /reactions/{reactionId} {
        allow get: if member() && exists(/databases/$(database)/documents/campusFeedPosts/$(postId));
        allow list: if member() && bounded(200) && exists(/databases/$(database)/documents/campusFeedPosts/$(postId));
        allow create: if member() && exists(/databases/$(database)/documents/campusFeedPosts/$(postId))
          && request.resource.data.keys().hasOnly(['uid','kind','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['like','interested']
          && reactionId == request.auth.uid + '_' + request.resource.data.kind
          && request.resource.data.createdAt == request.time;
        allow delete: if member() && (resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/campusFeedPosts/$(postId)).data.authorId == request.auth.uid);
      }
      allow get: if member();
      allow list: if member() && request.query.limit != null && request.query.limit <= 100;
      allow create: if member() && validPost(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if member() && resource.data.authorId == request.auth.uid && validPost(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','college','event','updatedAt']);
      allow delete: if member() && resource.data.authorId == request.auth.uid;
    }
  }
}
