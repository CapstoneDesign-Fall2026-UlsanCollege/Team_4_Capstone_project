rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validEvent(event) {
      return event == null || (event is map && event.keys().hasAll(['title','date','time','location']) && event.keys().hasOnly(['title','date','time','location'])
        && event.title is string && event.title.size() > 0 && event.title.size() <= 100
        && event.location is string && event.location.size() > 0 && event.location.size() <= 120
        && event.date is string && event.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && event.time is string && (event.time == '' || event.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }
    function validPost(data) {
      return data.keys().hasAll(['authorId','authorName','college','body','event','createdAt','updatedAt'])
        && data.keys().hasOnly(['authorId','authorName','college','body','event','createdAt','updatedAt'])
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 120
        && data.college is string && data.college.size() > 0 && data.college.size() <= 100
        && data.body is string && data.body.size() <= 2000 && (data.body.size() > 0 || data.event != null)
        && validEvent(data.event) && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /campusFeedPosts/{postId} {
      allow get: if member();
      allow list: if member() && request.query.limit != null && request.query.limit <= 100;
      allow create: if member() && validPost(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if member() && resource.data.authorId == request.auth.uid && validPost(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','college','event','updatedAt']);
      allow delete: if member() && resource.data.authorId == request.auth.uid;
    }
  }
}
