{
  "name": "campusvibes-react-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:feed-rules": "npm run test:feed-rules --workspace @campusvibes/backend",
    "test:shared-feed": "node tests/shared-feed.browser.js",
    "test:social-components": "node tests/social-components.browser.js",
    "test:social-regressions": "node tests/social-regressions.browser.js",
    "test:feed-photos": "node --test tests/feed-photo.test.js && npm run test:feed-photos --workspace @campusvibes/backend",
    "test:feed-photos-browser": "node tests/feed-photos.browser.js",
    "test:suggestions": "node tests/suggestions.browser.js",
    "test:assistant": "node --test tests/assistant.test.js",
    "test:gemini": "node --test tests/gemini.test.js && npm run test:assistant --workspace @campusvibes/backend",
    "test:gemini-browser": "node tests/gemini.browser.js",
    "test:profile": "node --test tests/profile.test.js",
    "test:profile-photos": "node --test tests/profile-photo.test.js",
    "test:profile-photos-browser": "node tests/profile-photos.browser.js",
    "test:badges": "node --test tests/progress-badges.test.js",
    "test:account": "node --test tests/account-sync.test.js",
    "test:account-browser": "node tests/account-persistence.browser.js",
    "test:notifications": "node --test tests/notifications.test.js",
    "test:maps": "node --test tests/event-maps.test.js",
    "test:notifications-rules": "npm run test:notifications-rules --workspace @campusvibes/backend",
    "test:notifications-browser": "node tests/notifications.browser.js",
    "test:smoke": "playwright test",
    "test:toast-mobile": "node tests/toast-mobile.browser.js"
  },
  "dependencies": {
    "@campusvibes/backend": "*",
    "firebase": "^12.19.0",
    "fuse.js": "^7.5.0",
    "lucide": "^1.55.0",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.0",
    "vite": "^6.4.3"
  }
}
